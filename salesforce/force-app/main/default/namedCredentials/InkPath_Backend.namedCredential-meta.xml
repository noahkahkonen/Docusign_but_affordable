<?xml version="1.0" encoding="UTF-8"?>
<!--
  Named Credential pointing at the InkPath backend on Heroku.
  EDIT calloutUrl to your deployed app URL before/after deploy (Setup → Named Credentials).
  The Apex controller calls `callout:InkPath_Backend/...`, so the developer name must stay
  "InkPath_Backend".
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>InkPath Backend</label>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
    <calloutUrl>https://YOUR-INKPATH-APP.herokuapp.com</calloutUrl>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <externalCredential>InkPath_Backend</externalCredential>
</NamedCredential>
