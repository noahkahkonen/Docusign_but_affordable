<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>InkPath User</label>
    <description>Send documents for InkPath e-signature and view signature requests.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>InkPathService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>InkPathWebhook</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <object>InkPath_Signature_Request__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions>
