<?xml version="1.0" encoding="UTF-8"?>
<!--
  External Credential for the InkPath backend.

  Authentication is a single custom header `x-api-key` carrying the backend's BACKEND_API_KEY.
  The header NAME and merge wiring now ship in metadata (the AuthHeader below), so a bare deploy no
  longer depends on someone hand-typing the exact lowercase header name in Setup.

  The SECRET value cannot live in source. After deploying, open Setup → Security → Named
  Credentials → External Credentials → "InkPath Backend" → the principal below, and add an
  Authentication Parameter named exactly `ApiKey` whose value is your backend BACKEND_API_KEY.
  The AuthHeader references it as {!$Credential.InkPath_Backend.ApiKey}. See salesforce/README.md.
-->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>InkPath Backend</label>
    <authenticationProtocol>Custom</authenticationProtocol>
    <!-- The x-api-key header itself: name + value wiring ship in source; only the secret VALUE
         (the ApiKey authentication parameter) is filled in by an operator post-deploy. -->
    <externalCredentialParameters>
        <parameterName>x-api-key</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!$Credential.InkPath_Backend.ApiKey}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>InkPathPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>2</sequenceNumber>
    </externalCredentialParameters>
</ExternalCredential>
