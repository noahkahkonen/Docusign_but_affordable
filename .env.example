# ── InkPath backend configuration ──────────────────────────────────────────────
# Copy to .env for local dev. NEVER commit a real .env. On Heroku, set these as
# config vars (Settings → Config Vars), not in a file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public URL this backend is reachable at. Used to build signer links and is the target
# of the Salesforce Named Credential. On Heroku this is your app's https URL.
APP_BASE_URL=http://localhost:3000

# ── Database (Heroku Postgres) ──────────────────────────────────────────────────
# Heroku sets DATABASE_URL automatically when the Postgres add-on is attached.
# For local dev, point at a local Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inkpath

# ── Salesforce OAuth 2.0 JWT Bearer flow ────────────────────────────────────────
# Create a Connected App with "Use digital signatures" (upload a cert), enable the
# OAuth scopes (api, refresh_token), and pre-authorize the integration user.
SF_LOGIN_URL=https://login.salesforce.com   # https://test.salesforce.com for sandboxes
SF_CLIENT_ID=                                # Connected App Consumer Key
SF_USERNAME=                                 # integration user to impersonate
# PEM private key matching the cert uploaded to the Connected App. Newlines may be
# escaped as \n in a single-line var — the app un-escapes them.
SF_PRIVATE_KEY=
SF_API_VERSION=60.0

# ── Signing ─────────────────────────────────────────────────────────────────────
SIGNING_LINK_TTL_HOURS=168   # 7 days

# ── Branding (light, simple, inviting — emerald) ────────────────────────────────
BRAND_NAME=InkPath
BRAND_PRIMARY_COLOR=#10b981
BRAND_LOGO_URL=
BRAND_SENDER_NAME=InkPath Signatures
BRAND_SENDER_EMAIL=no-reply@example.com
