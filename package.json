{
  "name": "inkpath",
  "version": "0.2.0",
  "description": "InkPath — an affordable, ESIGN/UETA-aligned e-signature engine for Salesforce CRE teams",
  "main": "dist/src/server.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "check:read-path": "tsx scripts/check-read-path.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "heroku-postbuild": "prisma generate && tsc -p tsconfig.json",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate:test": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inkpath_test prisma migrate deploy",
    "test": "vitest run",
    "test:db": "npm run db:migrate:test && DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inkpath_test RUN_DB_TESTS=1 vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.2",
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsforce": "^3.6.4",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "prisma": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
